<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets `dotnet user-secrets` store the dev connection string outside the repo. -->
    <UserSecretsId>099abc27-7222-4f9b-bebf-32236b87b494</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core: schema-as-code (migrations) and the simple CRUD paths.
         The SqlServer provider also brings in Microsoft.Data.SqlClient, which the
         hand-written search query uses directly (see Data/Queries/TicketSearchQuery.cs). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Design-time only: needed by `dotnet ef migrations add`. Not shipped in the publish output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- SMTP client for the escalation email (Stage 3). -->
    <PackageReference Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The email template is compiled into the DLL, so it can't be missing from a
         deployment. Read with GetManifestResourceStream in EscalationEmailBuilder. -->
    <EmbeddedResource Include="Templates\escalation.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project call `internal` helpers without making them public. -->
    <InternalsVisibleTo Include="TicketTracker.Api.Tests" />
  </ItemGroup>

</Project>
