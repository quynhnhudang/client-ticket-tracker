# /etc/tickettracker/app.env   (owner root:tickettracker, mode 640)
# Read by systemd (EnvironmentFile=) and passed to the app as environment variables.
# A double underscore means "section": Email__Host is configuration key Email:Host.
# One KEY=value per line; spaces and semicolons inside a value are fine without quotes.

# --- Database (least-privilege login created by deploy/sql/create-logins.sql) ---
# TrustServerCertificate=True is acceptable ONLY because SQL Server is on this same
# machine and the connection never leaves loopback. With RDS, remove it and install
# the RDS CA certificate instead.
ConnectionStrings__TicketTracker=Server=localhost;Database=TicketTracker;User ID=tickettracker_app;Password=CHANGE_ME;TrustServerCertificate=True

# --- Auth cookie encryption keys: must survive restarts, or everyone is logged out ---
DataProtection__KeysPath=/var/lib/tickettracker/keys

# --- First agent. Used only while the Agents table is empty. ---
# After the first successful start, DELETE the password line and restart.
SeedAgent__Email=agent@example.com
SeedAgent__Password=CHANGE_ME_AT_LEAST_12_CHARS
SeedAgent__DisplayName=Support Agent

# --- Escalation email (leave Email__Host empty to only log escalations) ---
Email__Host=sandbox.smtp.mailtrap.io
Email__Port=2525
Email__Security=StartTls
Email__Username=CHANGE_ME
Email__Password=CHANGE_ME
Email__FromAddress=tickets@example.com
Email__FromName=Client Ticket Tracker
Email__EngineeringAddresses=engineering@example.com
Email__AppBaseUrl=http://YOUR_EC2_PUBLIC_IP

# --- Optional LLM triage (leave empty to hide the "Suggest" button) ---
Triage__ApiKey=
