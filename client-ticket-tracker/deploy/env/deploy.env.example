# /etc/tickettracker/deploy.env   (owner root:ubuntu, mode 640)
# Read by deploy.sh only. The migrator login can change the schema (db_owner);
# the running app never gets this password.
MIGRATOR_CONNECTION="Server=localhost;Database=TicketTracker;User ID=tickettracker_migrator;Password=CHANGE_ME;TrustServerCertificate=True"
